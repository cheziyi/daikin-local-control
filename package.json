{
  "name": "daikin-local-control",
  "version": "0.0.0",
  "description": "Unofficial Node.js and TypeScript client for controlling Daikin air conditioners over the local network (LAN), with no cloud. Supports classic (BRP069, BRP072) and DSIOT (BRP084) Wi-Fi adapters.",
  "keywords": [
    "daikin",
    "daikin-ac",
    "daikin-api",
    "daikin-mobile-controller",
    "air-conditioner",
    "air-conditioning",
    "aircon",
    "hvac",
    "local-control",
    "local-api",
    "lan",
    "wifi-adapter",
    "brp069",
    "brp072a42",
    "brp072c42",
    "brp084",
    "dsiot",
    "skyair",
    "home-automation",
    "smart-home",
    "nodejs",
    "typescript",
    "thailand",
    "singapore",
    "hong-kong",
    "taiwan",
    "philippines",
    "australia",
    "new-zealand"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cheziyi/daikin-local-control#readme",
  "bugs": "https://github.com/cheziyi/daikin-local-control/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheziyi/daikin-local-control.git"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "DESIGN.md",
    "UNSUPPORTED.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./simulators": "./dist/simulators/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "pnpm typecheck && vitest run",
    "check": "biome check",
    "fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "undici": "^8.11.2"
  }
}
