{
  "name": "daikin-local-control",
  "version": "0.0.0",
  "description": "Unofficial local-network (LAN) control client for Daikin air-conditioner Wi-Fi adapters (classic CGI and DSIOT)",
  "keywords": [
    "daikin",
    "daikin-mobile-controller",
    "air-conditioner",
    "aircon",
    "local-control",
    "lan",
    "wifi-adapter",
    "brp072a42",
    "brp072c42",
    "brp084",
    "dsiot",
    "home-automation",
    "thailand",
    "singapore",
    "hong-kong",
    "taiwan",
    "philippines",
    "australia",
    "new-zealand"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheziyi/daikin-local-control.git"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "DESIGN.md",
    "UNSUPPORTED.md"
  ],
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "pnpm typecheck && vitest run",
    "check": "biome check",
    "fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "undici": "^8.11.2"
  }
}
